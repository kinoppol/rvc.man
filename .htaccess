# Front-controller routing. Path-independent — no RewriteBase, so the app works
# in /rvc.man, at a domain root, or anywhere else.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Application internals are never served directly.
    RewriteRule ^(app|config|sql|views|storage|bin|data)(/|$) - [F,L]

    # Real files and directories (assets, manifest, service worker) pass through.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes to the front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Extra guard for sensitive file types.
<FilesMatch "\.(sql|md|lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

DirectoryIndex index.php
